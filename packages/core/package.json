{
  "name": "@backend-master/securekit",
  "version": "1.0.0",
  "description": "Zero-runtime-dependency security toolkit core for Node.js APIs ? Config Compiler, Pipeline Runner, SecureKitContext, and error architecture.",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raghurajpratapsingh28/Securekit.git"
  },
  "bugs": "https://github.com/Raghurajpratapsingh28/Securekit/issues",
  "homepage": "https://github.com/Raghurajpratapsingh28/Securekit#readme",
  "keywords": [
    "security",
    "cors",
    "rate-limit",
    "helmet",
    "nodejs",
    "express",
    "middleware",
    "api-key",
    "headers",
    "securekit"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./crypto": {
      "types": "./dist/crypto/index.d.ts",
      "default": "./dist/crypto/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "pnpm run build && node --test tests/**/*.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.6.2"
  }
}
